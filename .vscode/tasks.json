{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "npm install",
			"type": "shell",
			"command": "npm install",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "test server",
			"type": "shell",
			"command": "npm test",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "build client",
			"type": "shell",
			"command": "npm run build",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "setup database",
			"type": "shell",
			"command": "npm run db:setup",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "seed database",
			"type": "shell",
			"command": "npm run seed",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		},
		{
			"label": "start app",
			"type": "shell",
			"command": "npm run dev",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "verify app",
			"type": "shell",
			"command": "node database/verify-app.js",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": []
		}
	]
}